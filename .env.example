# lifekit-stack .env — copy to .env on the VPS at /srv/openclaw/config/.env.
# Never committed; gitignored.
#
# Most defaults are fine. The required-to-set values are marked REQUIRED.

# ─── OpenClaw image ──────────────────────────────────────────────────────────

# Not configurable here. The OpenClaw version is the FROM tag in
# compose/openclaw-gateway/Dockerfile; Dependabot bumps it via PR and the CI
# deploy ships it (docs/runbook.md "Updating OpenClaw").

# ─── OpenClaw paths (host-side bind-mounts) ──────────────────────────────────

# Match what scripts/bootstrap-vps.sh creates. Override only if you moved them.
OPENCLAW_CONFIG_DIR=/srv/openclaw/config
OPENCLAW_WORKSPACE_DIR=/srv/openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/srv/openclaw/secret-key
LIFEKIT_LIFE_DIR=/srv/memory

# ─── Gateway network ─────────────────────────────────────────────────────────

# OpenClaw binds to 127.0.0.1:<port> on the host — no public exposure.
# Tailscale + SSH is the admin path.
OPENCLAW_GATEWAY_PORT=18789
# 'lan' is rejected by OpenClaw when running over plaintext ws:// for security.
# 'loopback' is correct for this single-host deploy: openclaw-cli and lifekit-
# orchestrator reach the gateway over the docker
# compose network, which terminates on 127.0.0.1 from the gateway's POV.
OPENCLAW_GATEWAY_BIND=loopback

# Optional: shared secret for the gateway HTTP API. Generate with `openssl rand -hex 32`.
# OPENCLAW_GATEWAY_TOKEN=

# Inbound hooks (compose/openclaw-gateway/platform.patch.json turns them on).
# openclaw.json references these three by name; the values live only here.
# All three must be set BEFORE the deploy that applies the hooks block: the
# deploy's dry run refuses the patch while one is missing or empty, leaves
# the gateway as it is, and ends red. Once hooks are on, do not remove the
# token: a gateway with hooks enabled and no token refuses to start.
#   OPENCLAW_HOOK_TOKEN  bearer token callers present. Its own secret, NOT the
#                        gateway token: `openssl rand -hex 32`.
#   OPENCLAW_HOOK_PATH   base path of the hook endpoints, non-guessable, e.g.
#                        "/hooks-$(openssl rand -hex 8)". Must start with "/".
#   OPENCLAW_FINANCE_CHAT  Telegram chat id the finance agent delivers to.
#                        Defaults to LIFEKIT_TELEGRAM_CHAT when unset.
# OPENCLAW_HOOK_TOKEN=
# OPENCLAW_HOOK_PATH=
# OPENCLAW_FINANCE_CHAT=123456789

# ─── Timezone ────────────────────────────────────────────────────────────────

OPENCLAW_TZ=Europe/Dublin

# ─── Orchestrator (devclaw) ──────────────────────────────────────────────────

# Telegram chat id used for orchestrator escalations (supervise-blocked Runs).
# Same value as TELEGRAM_OWNER_USER_ID below; left as its own var so it can be
# routed to a different chat (e.g. a "Kit ops" thread) without changing the
# bot owner.
# LIFEKIT_TELEGRAM_CHAT=123456789

# ─── Channels ────────────────────────────────────────────────────────────────

# Telegram bot — REQUIRED if you want Telegram routing.
# Get the token from @BotFather, your user ID from @userinfobot.
# After first deploy, add the channel interactively via:
#   docker compose -f compose/docker-compose.yml --profile cli run --rm openclaw-cli \
#     channels add --channel telegram --token "$TELEGRAM_BOT_TOKEN"
#
# Or set these here so the channel can be provisioned automatically (when wired):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_USER_ID=

# ─── lifekit-dashboard ───────────────────────────────────────────────────────

# Loopback-only HTTP port the dashboard binds on the host. Tailscale serve
# fronts this for the tailnet.
LIFEKIT_DASHBOARD_PORT=18790

# Host path where deploy.sh clones lifekit-hq/lifekit-dashboard (the dashboard
# image is built from this directory, not vendored into this repo).
LIFEKIT_DASHBOARD_DIR=/srv/lifekit-dashboard

# NOTE: the dashboard middleware authenticates with OPENCLAW_GATEWAY_TOKEN
# (set above) — there is no separate dashboard token. This entry is reserved
# for a future split-token model and is unused today.
LIFEKIT_DASHBOARD_TOKEN=

# ─── Google Workspace MCP (taylorwilsdon/google_workspace_mcp) ───────────────
#
# Single-user, streamable-http MCP server. Exposed to openclaw-gateway over the
# compose network at http://google-workspace-mcp:8000/mcp/ — NOT published to
# the host. See docs/google-mcp-setup.md for the one-time OAuth client + token
# generation flow (done on PC, refresh token scp'd to the VPS).

# OAuth client ID from the Google Cloud project (Desktop application type).
GOOGLE_OAUTH_CLIENT_ID=
# OAuth client secret paired with the ID above.
GOOGLE_OAUTH_CLIENT_SECRET=
# The Google account that owns the refresh token (single-user mode).
USER_GOOGLE_EMAIL=
# Which workspace services to expose as tools. Default keeps the surface tight.
# Valid services: gmail drive calendar docs sheets slides forms tasks contacts chat search
WORKSPACE_MCP_TOOLS="gmail drive calendar docs sheets tasks"

# ─── Observability (Grafana + Prometheus + Loki, box-level) ──────────────────
#
# Moved here from finance-sentry's compose on 2026-09-06. Loopback-bound;
# Grafana is fronted by Tailscale Serve on :3000. Alerts go to Telegram
# straight from Grafana using DEVCLAW_BOT_TOKEN (falling back to
# TELEGRAM_BOT_TOKEN above) — no notify-relay hop. The destination chat is
# DEVCLAW_CHAT (falling back to LIFEKIT_TELEGRAM_CHAT above), which deploy.sh
# SUBSTITUTES into the contact point rather than passing as an env var —
# Grafana re-types an all-digit env value as a number and the telegram
# integration then refuses to start. Missing ⇒ the deploy fails loudly.

# Grafana admin login (was in finance-sentry's docker/.env — copy the values).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Public root URL Grafana renders links with (the Tailscale Serve address).
GRAFANA_ROOT_URL=https://<host>.<tailnet>.ts.net:3000
# The ONE origin (scheme://host[:port], no wildcard) allowed to frame Grafana in an
# iframe; becomes the CSP frame-ancestors. Optional: when unset, deploy derives
# https://<this host's tailnet name>[:<port>] (the HTTPS port the dashboard is
# served on via Tailscale Serve); if that can't be derived, embedding stays denied ('none'). Set it to override.
# GRAFANA_EMBED_ORIGIN=https://<dashboard-origin>
# Secret ping URL of an external dead-man check (docs/runbook.md "External heartbeat").
# Unset = heartbeat disabled.
# LIFEKIT_EXTERNAL_HEARTBEAT_URL=
# Loopback ports (defaults shown).
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# Data volumes are EXTERNAL (created by finance-sentry's former compose project
# as docker_<name>). Override only if the box's volumes are named differently.
# LIFEKIT_GRAFANA_VOLUME=docker_grafana_data
# LIFEKIT_PROMETHEUS_VOLUME=docker_prometheus_data
# LIFEKIT_LOKI_VOLUME=docker_loki_data
# tempo_data is a normal (non-external) project volume, new with issue #144 —
# override only for naming parity with the vars above, not because it must
# pre-exist.
# LIFEKIT_TEMPO_VOLUME=compose_tempo_data
# Where finance-sentry's deploy drops its dashboard JSON for Grafana to load.
# LIFEKIT_FINANCE_SENTRY_DASHBOARDS=/srv/finance-sentry/grafana-dashboards
# Group id of /var/run/docker.sock, so container-exporter (runs as nobody) can
# read it. deploy.sh takes it from the socket itself when unset.
# DOCKER_GID=990

# ─── OpenTelemetry (optional) ────────────────────────────────────────────────

# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=lifekit-stack
