#!/usr/bin/env bash
# What CI runs (.github/workflows/ci.yml), reproduced in this worktree.
#
# CI jobs and their local equivalent:
#   lint                  -> pre-commit run --all-files (+ scripts/check-doc-drift.sh)
#   pytest                -> the four pytest suites below
#   notify-relay-tests    -> node --test in compose/notify-relay (CI runs it inside
#                            node:22-trixie-slim with --network none, proving nothing
#                            reaches Telegram; here it runs on the host node 22.x,
#                            so that one property is CI's to prove)
#   gitleaks-full         -> gitleaks over the commits this branch adds
#   secrets-gateway-decrypt -> NOT runnable off-box: the gateway age key never leaves
#                            the self-hosted runner. Only an input change triggers it
#                            in CI (secrets/lifekit-gateway.env.sops,
#                            compose/openclaw-gateway/install-sops.sh, ci.yml).
#   deploy                -> main only, never from here.
#
# Tooling: the script provisions its own venv (.devclaw/.venv, gitignored) and, where
# the box lacks them, the pinned jq and rsync the shell-script tests shell out to.
#
# Two pre-commit hooks run in docker (shellcheck-precommit, hadolint-docker). Where
# there is no docker this script runs shellcheck from shellcheck-py over the same
# file set, and REFUSES to go green when the branch touched a Dockerfile it cannot
# lint - a green here has to mean a green CI.
set -euo pipefail

cd "$(dirname "$0")/.."
REPO="$PWD"
VENV="$REPO/.devclaw/.venv"
SHELLCHECK_PIN=0.10.0.1  # matches shellcheck-precommit v0.10.0 in .pre-commit-config.yaml
BASE="${VERIFY_BASE:-origin/main}"
JQ_VERSION=1.7.1  # the shell-script tests shell out to it; CI's runner image ships it
RSYNC_VERSION=3.4.1  # likewise; no upstream static build exists, so it is built here
RSYNC_SHA256=2924bcb3a1ed8b551fc101f740b9f0fe0a202b115027647cf69850d65fd88c52

step() { printf '\n=== %s\n' "$1"; }
note() { printf 'NOTE: %s\n' "$1"; }

step "python environment"
if [[ ! -x "$VENV/bin/python" ]]; then
  python3 -m venv "$VENV"
fi
"$VENV/bin/pip" install --quiet --upgrade pip
"$VENV/bin/pip" install --quiet -r requirements.txt pre-commit "shellcheck-py==$SHELLCHECK_PIN"
PATH="$VENV/bin:$PATH"
export PATH

# Many tests under scripts/tests drive repo shell scripts that pipe through jq
# (a fake `gh` in a tmpdir, for one), and fail with "jq: command not found"
# where the box has none - CI's ubuntu-latest runner ships it. Provision the
# pinned release into the venv (gitignored, never committed), checksum first.
ensure_jq() {
  command -v jq >/dev/null 2>&1 && return 0
  local arch sha url dir
  case "$(uname -m)" in
    aarch64 | arm64)
      arch=arm64
      sha=4dd2d8a0661df0b22f1bb9a1f9830f06b6f3b8f7d91211a1ef5d7c4f06a8b4a5
      ;;
    x86_64 | amd64)
      arch=amd64
      sha=5942c9b0934e510ee61eb3e30273f1b3fe2590df93933a93d7c58b81d19c8ff5
      ;;
    *)
      echo "FAIL: no pinned jq for $(uname -m); install jq and re-run" >&2
      return 1
      ;;
  esac
  url="https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${arch}"
  dir="$(mktemp -d)"
  curl -fsSL -o "$dir/jq" "$url"
  printf '%s  %s\n' "$sha" "$dir/jq" | sha256sum --check --quiet
  chmod +x "$dir/jq"
  mv "$dir/jq" "$VENV/bin/jq"
  rmdir "$dir"
  note "installed the pinned jq ${JQ_VERSION} into the venv"
}
ensure_jq

# scripts/deploy-openclaw.sh syncs the memory-audit directory with
# `rsync -a --delete --exclude`, and the deploy tests run that phase for real.
# Upstream publishes no static rsync, so build the pinned release once into the
# venv with every optional dependency off - plain -a is all the tested calls use.
ensure_rsync() {
  command -v rsync >/dev/null 2>&1 && return 0
  command -v cc >/dev/null 2>&1 || {
    echo "FAIL: no rsync and no C compiler to build the pinned one" >&2
    return 1
  }
  local dir
  dir="$(mktemp -d)"
  curl -fsSL -o "$dir/rsync.tar.gz" \
    "https://download.samba.org/pub/rsync/src/rsync-${RSYNC_VERSION}.tar.gz"
  printf '%s  %s\n' "$RSYNC_SHA256" "$dir/rsync.tar.gz" | sha256sum --check --quiet
  tar -xzf "$dir/rsync.tar.gz" -C "$dir"
  if ! (
    cd "$dir/rsync-${RSYNC_VERSION}" &&
      ./configure --disable-openssl --disable-xxhash --disable-zstd --disable-lz4 \
        --disable-md2man --disable-acl-support --disable-xattr-support &&
      make -j2
  ) > "$dir/build.log" 2>&1; then
    echo "FAIL: the pinned rsync did not build; log in $dir/build.log" >&2
    return 1
  fi
  mv "$dir/rsync-${RSYNC_VERSION}/rsync" "$VENV/bin/rsync"
  rm -rf "$dir"
  note "built the pinned rsync ${RSYNC_VERSION} into the venv (no optional deps)"
}
ensure_rsync

have_docker=no
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  have_docker=yes
fi

changed_files() {
  # Everything this branch touches: its commits over the base (when the base is
  # known), plus staged, unstaged and untracked work - a guard that reads only
  # committed history goes green on a file that is still in the working tree.
  if git rev-parse --verify --quiet "$BASE" >/dev/null; then
    git diff --name-only "$BASE...HEAD"
  fi
  git diff --name-only HEAD
  git ls-files --others --exclude-standard
}

step "pre-commit (gitleaks, hygiene, yamllint, shellcheck, hadolint, ruff, doc-drift)"
if [[ "$have_docker" == yes ]]; then
  pre-commit run --all-files --show-diff-on-failure
else
  note "no docker: the shellcheck and hadolint hooks are skipped here, see below"
  SKIP=shellcheck,hadolint-docker pre-commit run --all-files --show-diff-on-failure

  step "shellcheck (shellcheck-py $SHELLCHECK_PIN, the docker hook's file set)"
  # identify is pre-commit's own file-type library, so this is the hook's file set.
  python - > "$VENV/shellfiles" <<'SHFILES'
import subprocess
from identify.identify import tags_from_path

tracked = subprocess.run(
    ["git", "ls-files", "-z"], capture_output=True, check=True
).stdout.split(b"\0")
for raw in tracked:
    if not raw:
        continue
    path = raw.decode()
    try:
        if "shell" in tags_from_path(path):
            print(path)
    except OSError:
        pass
SHFILES
  xargs -a "$VENV/shellfiles" -r -d '\n' shellcheck
  printf 'shellcheck: %s files clean\n' "$(wc -l < "$VENV/shellfiles")"

  step "hadolint"
  changed_files | sort -u > "$VENV/changed"
  touched_dockerfiles="$(python - "$VENV/changed" <<'DOCKERFILES'
import sys
from pathlib import Path

from identify.identify import tags_from_filename

for line in Path(sys.argv[1]).read_text().splitlines():
    # By name, not by path: a renamed or deleted file is no longer on disk.
    if line and "dockerfile" in tags_from_filename(line.rsplit("/", 1)[-1]):
        print(line)
DOCKERFILES
  )"
  if [[ -n "$touched_dockerfiles" ]]; then
    echo "FAIL: this branch changes a file hadolint lints and hadolint needs" >&2
    echo "      docker, which this environment has none of:" >&2
    while IFS= read -r touched; do
      echo "        $touched" >&2
    done <<< "$touched_dockerfiles"
    echo "      Hand back: BLOCKED: env - no docker for the hadolint hook." >&2
    exit 1
  fi
  note "no Dockerfile changed on this branch; hadolint has nothing to catch here"
fi

step "doc drift (README <-> compose service count)"
bash scripts/check-doc-drift.sh

step "pytest (container-exporter, quota-share, ops-report, platform-contract)"
# Serial on purpose: the box is shared with other sessions.
python -m pytest -q -p no:cacheprovider \
  compose/container-exporter/tests scripts/quota-share/tests \
  scripts/ops-report/tests scripts/tests

step "notify-relay (node --test)"
if command -v node >/dev/null 2>&1; then
  (cd compose/notify-relay && node --test)
else
  note "no node: CI's notify-relay job cannot be reproduced here"
fi

step "gitleaks (this branch's commits)"
# pre-commit installs the pinned gitleaks for its own hook; reuse that binary
# rather than fetching a second copy that could drift from the hook's rev.
leaks="$(find "${PRE_COMMIT_HOME:-$HOME/.cache/pre-commit}" -type f -name gitleaks -perm -u+x 2>/dev/null | head -1)"
if [[ -z "$leaks" ]]; then
  echo "FAIL: no gitleaks binary under the pre-commit cache, so CI's full-history" >&2
  echo "      scan has no stand-in here. Re-run after the pre-commit step installs" >&2
  echo "      its hook environments." >&2
  exit 1
fi
if git rev-parse --verify --quiet "$BASE" >/dev/null; then
  "$leaks" detect --no-banner --redact --log-opts="$BASE..HEAD"
  note "the commits this branch adds; CI scans the whole history"
else
  note "no $BASE to diff against: skipping the range scan"
fi
# The hook above is `gitleaks protect --staged`: it reads the index, so work that
# is neither committed nor staged is in neither scan. Hence the tree scan here.
"$leaks" detect --no-banner --redact --no-git --source "$REPO"
note "and the working tree, this repo's files only"

printf '\nverify: green\n'
