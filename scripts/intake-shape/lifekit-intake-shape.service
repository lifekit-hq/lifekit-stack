[Unit]
Description=Intake shape step: a shaping item per accepted idea, a ready issue per owner answer

[Service]
Type=oneshot
# The account that owns the firstmate home (the captain hold), has gh logged in
# and reaches the intake directory through an ACL (docs/runbook.md "Intake shape
# step"). The gateway's video.py chmods that directory and its lock on every
# run, which clears the ACL mask, so the root ExecStartPre (the `+` prefix)
# re-applies the ACL, access and default, before every sweep.
# scripts/intake-shape/install-intake-shape.sh substitutes the placeholders.
User=__ADMIN_USER__
ExecStartPre=+/usr/bin/setfacl -R -m u:__ADMIN_USER__:rwX,m::rwX,d:u:__ADMIN_USER__:rwX,d:m::rwX /var/lib/lifekit/intake
# TASKS_AXI and PATH (the tool's directory first, so it and node resolve) are
# the installer's TASKS_AXI or its admin-account lookup; a system unit's own PATH
# has neither, and fm-captain-hold.sh finds tasks-axi through PATH.
Environment="TASKS_AXI=__TASKS_AXI__" "PATH=__UNIT_PATH__"
# fleet-policy (the decision matrix) answers each accepted row before anything
# is held; the installer resolves its absolute path the same way.
Environment="INTAKE_SHAPE_FLEET_POLICY=__FLEET_POLICY__"
Environment="INTAKE_SHAPE_FM_HOME=__FM_HOME__" "INTAKE_SHAPE_INTAKE=/var/lib/lifekit/intake" "INTAKE_SHAPE_REPOS=__REPOS__"
ExecStart=/usr/bin/python3 /usr/local/libexec/lifekit-intake-shape/intake_shape.py sweep
TimeoutStartSec=300
Nice=10
