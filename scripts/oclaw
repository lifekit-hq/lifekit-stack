#!/usr/bin/env bash
# oclaw — run an OpenClaw CLI command on the VPS as if it were local.
#
# Wraps `ssh <vps> docker compose -p openclaw --profile cli run --rm openclaw-cli <args>`.
# Lets you run `oclaw status`, `oclaw channels list`, etc. from your dev machine
# without memorizing the docker compose incantation.
#
# Put this on your PATH (e.g. symlink to ~/.local/bin/oclaw):
#   ln -s ~/projects/lifekit-stack/scripts/oclaw ~/.local/bin/oclaw
#
# Env:
#   VPS                 SSH target (default: denys@100.87.201.43)
#   OCLAW_ENV_FILE      Compose env file on VPS (default: /srv/lifekit-secrets/stack.env)
#   OCLAW_COMPOSE_DIR   OpenClaw compose dir on VPS (default: /srv/lifekit-stack/compose/openclaw)

set -euo pipefail

VPS="${VPS:-denys@100.87.201.43}"
ENV_FILE="${OCLAW_ENV_FILE:-/srv/lifekit-secrets/stack.env}"
COMPOSE_DIR="${OCLAW_COMPOSE_DIR:-/srv/lifekit-stack/compose/openclaw}"

# Decide whether to allocate a TTY. Many openclaw subcommands (login, configure)
# need one; others (status, channels list) don't. Default to -t when stdin is
# itself a TTY, since that's the interactive case.
TTY_FLAG=""
if [[ -t 0 && -t 1 ]]; then
  TTY_FLAG="-t"
fi

# shellcheck disable=SC2029 # remote expansion is intentional
# `compose run --rm` spawns a one-shot container that exits when openclaw exits.
# Avoids depending on a long-running openclaw-cli container.
# `sudo -u lifekit` runs as the user that owns the compose dir + .env, so we
# don't need to relax permissions on those for the admin user.
# The openclaw-cli service's entrypoint is `node dist/index.js`, so we pass
# subcommand args directly (no leading `openclaw`).
exec ssh $TTY_FLAG "$VPS" "sudo -u lifekit bash -c 'cd $COMPOSE_DIR && docker compose -p openclaw --env-file $ENV_FILE --profile cli run --rm --no-deps openclaw-cli $(printf '%q ' "$@")'"
