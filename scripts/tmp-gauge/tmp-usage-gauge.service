[Unit]
Description=Export /tmp usage to node-exporter's textfile collector

[Service]
Type=oneshot
# The textfile directory is owned by the admin account (README "VPS users").
# install-host-gauges.sh substitutes the placeholder at install time.
User=__ADMIN_USER__
ExecStart=/usr/local/bin/tmp-usage-gauge.sh /var/lib/node_exporter/textfile

[Install]
WantedBy=multi-user.target
